<Window x:Class="QuizSystem.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QuizSystem" Height="520" Width="820"
        Icon="/Assets/favicon.ico">

    <Grid Margin="16">

        <!-- ========================= -->
        <!-- PANEL 0: MENU (IsInMenu = true) -->
        <!-- ========================= -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInMenu}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="Wybierz quiz"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Szukaj:"
                           Opacity="0.75"
                           Margin="0,0,0,4"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <ListBox ItemsSource="{Binding Quizzes}"
                         SelectedItem="{Binding SelectedQuiz}"
                         Height="260">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" Opacity="0.7" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding QuestionCount, StringFormat=Liczba pytań: {0}}"
                                               FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Rozpocznij quiz"
                        Margin="0,12,0,0"
                        Width="180"
                        HorizontalAlignment="Right"
                        Command="{Binding StartQuizCommand}"/>
            </StackPanel>
        </Border>

        <!-- ========================= -->
        <!-- PANEL 1: QUIZ (IsInMenu=false i IsFinished=false) -->
        <!-- ========================= -->
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>

                        <!-- jeśli jesteśmy w menu -> quiz znika -->
                        <DataTrigger Binding="{Binding IsInMenu}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                        <!-- jeśli quiz zakończony -> quiz znika -->
                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="Bold" />

                <TextBlock Grid.Row="1"
                           Margin="0,6,0,12"
                           Text="{Binding Description}"
                           Opacity="0.8"
                           TextWrapping="Wrap"/>

                <Border Grid.Row="2" Padding="12" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentQuestion.Content}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <!-- Odpowiedzi + delikatne kolorowanie po Finish -->
                        <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- kolorujemy Border, nie CheckBox -->
                                    <Border CornerRadius="6"
                                            Padding="6"
                                            Margin="0,4,0,4"
                                            Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>

                                                <Style.Triggers>

                                                    <!-- ✅ Poprawna odpowiedź (po zakończeniu) -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsQuizFinished}" Value="True"/>
                                                            <Condition Binding="{Binding IsCorrect}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#DFF5EA"/>
                                                    </MultiDataTrigger>

                                                    <!-- ❌ Zaznaczona, ale błędna -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsQuizFinished}" Value="True"/>
                                                            <Condition Binding="{Binding IsCorrect}" Value="False"/>
                                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#FBEAEA"/>
                                                    </MultiDataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <CheckBox Content="{Binding Text}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Background="Transparent"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentNumber}" FontWeight="Bold"/>
                        <TextBlock Text="/"/>
                        <TextBlock Text="{Binding TotalQuestions}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                        <Button Content="Poprzednie" Margin="16,0,0,0" Command="{Binding PrevCommand}">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                        </Button>
                        <Button Content="Następne" Margin="8,0,0,0" Command="{Binding NextCommand}">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                        </Button>
                        <Button Content="Zakończ" Margin="8,0,0,0" Command="{Binding FinishCommand}">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                        </Button>
                        <Button Content="Restart" Margin="8,0,0,0" Command="{Binding RestartCommand}">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                        </Button>
                        <Button Content="Wyjdź" Margin="8,0,0,0" Command="{Binding CancelCommand}">
                            <Button.Effect>
                                <DropShadowEffect/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4" Margin="0,12,0,0" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Wynik: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Score}" />
                        <TextBlock Text=" / " />
                        <TextBlock Text="{Binding TotalQuestions}" />
                        <TextBlock Text="  (kliknij Zakończ, aby policzyć)" Margin="12,0,0,0" Opacity="0.7"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================= -->
        <!-- PANEL 2: KONIEC (IsFinished=true i IsInMenu=false) -->
        <!-- ========================= -->
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="18">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>

                        <!-- jeśli menu -> koniec ukryty -->
                        <DataTrigger Binding="{Binding IsInMenu}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsFinished}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="✅ Quiz zakończony"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

                <TextBlock Text="{Binding FinishedMessage}"
                   FontSize="16"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

                <!-- PODSUMOWANIE -->
                <Border BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,16">

                    <StackPanel>
                        <TextBlock Text="Podsumowanie odpowiedzi:"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                        <ScrollViewer Height="637" VerticalScrollBarVisibility="Auto">
                            <!-- UWAGA: tu bindujesz do Questions z MainViewModel (lista QuestionViewModel) -->
                            <ItemsControl ItemsSource="{Binding Questions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <!-- Karta pytania (kolor zależny od IsCorrect pytania) -->
                                        <Border CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,10"
                                        BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#DDDDDD"/>

                                                    <Style.Triggers>
                                                        <!-- ✅ pytanie poprawne -->
                                                        <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                            <Setter Property="Background" Value="#DFF5EA"/>
                                                            <Setter Property="BorderBrush" Value="#86C7A7"/>
                                                        </DataTrigger>

                                                        <!-- ❌ pytanie błędne -->
                                                        <DataTrigger Binding="{Binding IsCorrect}" Value="False">
                                                            <Setter Property="Background" Value="#FBEAEA"/>
                                                            <Setter Property="BorderBrush" Value="#D48B8B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding ResultLabel}"
                                                   Margin="0,6,0,8"
                                                   FontWeight="Bold"/>

                                                <!-- Odpowiedzi w tym pytaniu: tu bindujesz do Options (NIE do Questions!) -->
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <!-- pojedyncza odpowiedź (kolor zależny od AnswerOptionViewModel) -->
                                                            <Border CornerRadius="6"
                                                            Padding="6"
                                                            Margin="0,3,0,3">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>

                                                                        <Style.Triggers>
                                                                            <!-- ✅ poprawna odpowiedź (zawsze zielona po Finish) -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsQuizFinished}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsCorrect}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="#CFEFE0"/>
                                                                            </MultiDataTrigger>

                                                                            <!-- ❌ błędna zaznaczona (czerwona) -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsQuizFinished}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsCorrect}" Value="False"/>
                                                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="#F5D1D1"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <StackPanel Orientation="Horizontal">
                                                                    <CheckBox IsChecked="{Binding IsSelected}"
                                                                      IsEnabled="False"
                                                                      Margin="0,0,6,0"/>
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Restart"
                    Width="120"
                    Command="{Binding RestartCommand}"/>

                    <Button Content="Zamknij aplikację"
                    Width="160"
                    Margin="12,0,0,0"
                    Command="{Binding CloseAppCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>


    </Grid>
</Window>
